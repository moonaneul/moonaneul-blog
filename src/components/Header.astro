---
const pathname = Astro.url.pathname;

const navItems = [
  { label: 'Writing', href: '/writing/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Archive', href: '/archive/' },
  { label: 'About', href: '/about/' },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="moonaneul 홈">
      moonaneul
    </a>

    <nav aria-label="주요 메뉴">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'nav-link',
                pathname.startsWith(item.href) && 'is-active',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
  }

  .header-inner {
    width: min(calc(100% - 48px), var(--page-width));
    margin: 0 auto;
    padding: 32px 0;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid var(--color-border);
  }

  .wordmark {
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 28px;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .nav-link {
    position: relative;

    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 500;

    transition: color 160ms ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-text);
  }

  .nav-link.is-active::after {
    content: '';

    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;

    height: 1px;

    background: var(--color-accent);
  }

  @media (max-width: 700px) {
    .header-inner {
      width: min(calc(100% - 32px), var(--page-width));
      padding: 22px 0;
    }

    .nav-list {
      display: none;
    }
  }
</style>