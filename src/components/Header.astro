---
const pathname = Astro.url.pathname;

const navItems = [
  { label: 'Writing', href: '/writing/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Archive', href: '/archive/' },
  { label: 'About', href: '/about/' },
];

function isActive(href: string) {
  if (href === '/writing/') {
    return (
      pathname.startsWith('/writing/') ||
      pathname.startsWith('/category/')
    );
  }

  return pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="moonaneul 홈">
      moonaneul
    </a>

    <!-- Desktop navigation -->
    <nav class="desktop-nav" aria-label="주요 메뉴">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'nav-link',
                isActive(item.href) && 'is-active',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile navigation -->
    <details class="mobile-menu">
      <summary>
        <span>Menu</span>
      </summary>

      <nav class="mobile-nav" aria-label="모바일 주요 메뉴">
        <ul>
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'mobile-link',
                  isActive(item.href) && 'is-active',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}

              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
  }

  .header-inner {
    position: relative;

    width: min(calc(100% - 48px), var(--page-width));
    margin: 0 auto;
    padding: 32px 0;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid var(--color-border);
  }

  /* Wordmark */

  .wordmark {
    position: relative;
    z-index: 20;

    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* Desktop */

  .nav-list {
    display: flex;
    align-items: center;
    gap: 28px;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .nav-link {
    position: relative;

    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 500;

    transition: color 160ms ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-text);
  }

  .nav-link.is-active::after {
    content: '';

    position: absolute;
    right: 0;
    bottom: -8px;
    left: 0;

    height: 1px;

    background: var(--color-accent);
  }

  /* Mobile */

  .mobile-menu {
  display: none;
}

@media (max-width: 700px) {
  .header-inner {
    width: min(calc(100% - 32px), var(--page-width));
    padding: 22px 0;
  }

  .desktop-nav {
    display: none;
  }

  .mobile-menu {
    display: block;
  }

  /* Menu 버튼 */
  .mobile-menu summary {
    position: relative;
    z-index: 20;

    padding: 4px 0;

    color: var(--color-text-muted);
    font-size: 0.86rem;
    font-weight: 500;

    cursor: pointer;

    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary::marker {
    content: '';
  }

  .mobile-menu summary::after {
    content: ' +';

    color: var(--color-text-light);
  }

  .mobile-menu[open] summary::after {
    content: ' −';
  }

  /* 펼쳐지는 메뉴 전체 */
  .mobile-nav {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  z-index: 10;

  padding: 8px 0 16px;

  background: var(--color-bg);
  border-bottom: 1px solid var(--color-border);
}

  .mobile-nav ul {
    width: min(calc(100% - 32px), var(--page-width));

    margin: 0 auto;
    padding: 0;

    list-style: none;
  }

  .mobile-nav li {
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-nav li:last-child {
    border-bottom: 0;
  }

  .mobile-link {
    min-height: 48px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    color: var(--color-text-muted);

    font-size: 0.95rem;
    font-weight: 500;
  }

  .mobile-link:hover,
  .mobile-link.is-active {
    color: var(--color-text);
    font-weight: 600;
  }
}
</style>