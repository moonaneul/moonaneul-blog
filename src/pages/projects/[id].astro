---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects
    .filter((project) => !project.data.draft)
    .map((project) => ({
      params: {
        id: project.id,
      },
      props: {
        project,
      },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout
  title={`${project.data.name} | moonaneul`}
  description={project.data.description}
>
  <main id="main-content" class="project-page">
    <article class="project">
      <a class="back" href="/projects/">
        ← Projects
      </a>

      <header class="project-header">
        <p class="project-label">PROJECT</p>

        <h1>{project.data.name}</h1>

        <p class="project-description">
          {project.data.description}
        </p>

        {project.data.period && (
          <p class="project-period">
            {project.data.period}
          </p>
        )}
      </header>

      <div class="divider"></div>

      <div class="project-body">
        <Content />
      </div>

      {
        project.data.tags.length > 0 && (
          <footer class="project-footer">
            <p class="footer-label">Topics</p>

            <ul class="tag-list">
              {project.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </footer>
        )
      }
    </article>
  </main>
</Layout>

<style>
  .project-page {
    width: min(calc(100% - 48px), var(--page-width));
    margin: 0 auto;
    padding: 72px 0 140px;
  }

  .project {
    width: min(100%, var(--reading-width));
    margin: 0 auto;
  }

  .back {
    color: var(--color-text-muted);
    font-size: 0.82rem;

    transition: color 160ms ease;
  }

  .back:hover {
    color: var(--color-accent);
  }

  .project-header {
    margin-top: 64px;
  }

  .project-label {
    color: var(--color-accent);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .project-header h1 {
    margin-top: 18px;

    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 620;
    letter-spacing: -0.045em;
  }

  .project-description {
    margin-top: 22px;

    color: var(--color-text-muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .project-period {
    margin-top: 20px;

    color: var(--color-text-light);
    font-size: 0.76rem;
    letter-spacing: 0.05em;
  }

  .divider {
    height: 1px;
    margin: 56px 0 64px;

    background: var(--color-border);
  }

  .project-body {
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .project-body :global(p) {
    margin: 0 0 1.5em;
  }

  .project-body :global(h2) {
    margin: 3.2em 0 1em;

    font-size: 1.75rem;
    font-weight: 620;
    letter-spacing: -0.035em;
  }

  .project-body :global(h3) {
    margin: 2.5em 0 0.8em;

    font-size: 1.3rem;
    font-weight: 600;
  }

  .project-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project-footer {
    margin-top: 80px;
    padding-top: 30px;

    border-top: 1px solid var(--color-border);
  }

  .footer-label {
    margin-bottom: 12px;

    color: var(--color-text-light);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .tag-list li {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 700px) {
    .project-page {
      width: min(calc(100% - 32px), var(--page-width));
      padding: 48px 0 96px;
    }

    .project-header {
      margin-top: 48px;
    }

    .project-header h1 {
      font-size: 2.3rem;
    }

    .project-description {
      font-size: 1rem;
    }

    .divider {
      margin: 44px 0 48px;
    }

    .project-body {
      font-size: 1rem;
      line-height: 1.82;
    }
  }
</style>