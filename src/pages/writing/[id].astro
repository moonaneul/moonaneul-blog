---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: {
        id: post.id,
      },
      props: {
        post,
      },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatMeta(value: string) {
  return value.replaceAll('-', ' ').toUpperCase();
}

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('ko-KR', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);
}
---

<Layout
  title={`${post.data.title} | moonaneul`}
  description={post.data.description}
  type="article"
>
  <main id="main-content" class="article-page">
    <article>
      <header class="article-header">
        <p class="article-meta">
          {formatMeta(post.data.category)}
          <span aria-hidden="true"> · </span>
          {formatMeta(post.data.type)}
        </p>

        <h1>{post.data.title}</h1>

        <p class="article-description">
          {post.data.description}
        </p>

        <div class="article-date">
          <time datetime={post.data.publishedAt.toISOString()}>
            {formatDate(post.data.publishedAt)}
          </time>

          {post.data.updatedAt && (
            <>
              <span aria-hidden="true"> · </span>
              <span>
                UPDATED {formatDate(post.data.updatedAt)}
              </span>
            </>
          )}
        </div>
      </header>

      <div class="article-divider"></div>

      <div class="article-body">
        <Content />
      </div>

      {(post.data.tags.length > 0 || post.data.project) && (
        <footer class="article-footer">
          {post.data.tags.length > 0 && (
            <section class="article-footer-section">
              <p class="footer-label">Tags</p>

              <ul class="tag-list">
                {post.data.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </section>
          )}

          {post.data.project && (
            <section class="article-footer-section">
              <p class="footer-label">Project</p>

              <a
                class="project-link"
                href={`/projects/${post.data.project.id}/`}
              >
                {post.data.project.id}
                <span aria-hidden="true"> →</span>
              </a>
            </section>
          )}
        </footer>
      )}
    </article>
  </main>
</Layout>

<style>
  .article-page {
    width: min(calc(100% - 48px), var(--page-width));
    margin: 0 auto;
    padding: 104px 0 144px;
  }

  article {
    width: min(100%, var(--reading-width));
    margin: 0 auto;
  }

  /* ------------------------------
     Article Header
  ------------------------------ */

  .article-meta {
    color: var(--color-accent);

    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.08em;
  }

  .article-header h1 {
    max-width: 680px;
    margin-top: 22px;

    font-size: clamp(2.2rem, 5vw, 3rem);
    line-height: 1.28;
    font-weight: 500;
    letter-spacing: -0.04em;

    word-break: keep-all;
  }

  .article-description {
    max-width: 640px;
    margin-top: 24px;

    color: var(--color-text-muted);

    font-size: 1.06rem;
    line-height: 1.75;
    letter-spacing: -0.012em;

    word-break: keep-all;
  }

  .article-date {
    margin-top: 24px;

    color: var(--color-text-light);

    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.04em;
  }

  .article-divider {
    height: 1px;
    margin: 64px 0 72px;

    background: var(--color-border);
  }

  /* ------------------------------
     Article Body
  ------------------------------ */

  .article-body {
    color: var(--color-text);

    font-size: 1.05rem;
    line-height: 1.88;
    letter-spacing: -0.012em;

    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .article-body :global(p) {
    margin: 0 0 1.65em;
  }

  .article-body :global(strong) {
    font-weight: 650;
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    scroll-margin-top: 48px;
  }

  .article-body :global(h2) {
    margin: 3.4em 0 1em;

    font-size: 1.75rem;
    line-height: 1.42;
    font-weight: 620;
    letter-spacing: -0.035em;

    word-break: keep-all;
  }

  .article-body :global(h3) {
    margin: 2.7em 0 0.85em;

    font-size: 1.28rem;
    line-height: 1.5;
    font-weight: 600;
    letter-spacing: -0.025em;

    word-break: keep-all;
  }

  /* ------------------------------
     Lists
  ------------------------------ */

  .article-body :global(ul),
  .article-body :global(ol){
    margin: 1.5em 0 1.8em;
    padding-left: 1.45em;
}

.article-body :global(ul) {
  list-style: disc;
}

.article-body :global(ol) {
  list-style: decimal;
}

  .article-body :global(li) {
    padding-left: 0.2em;
  }

  .article-body :global(li + li) {
    margin-top: 0.5em;
  }

  /* ------------------------------
     Links
  ------------------------------ */

  .article-body :global(a) {
    color: var(--color-accent);

    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;

    transition: opacity 160ms ease;
  }

  .article-body :global(a:hover) {
    opacity: 0.72;
  }

  /* ------------------------------
     Blockquote
  ------------------------------ */

  .article-body :global(blockquote) {
    margin: 2.4em 0;
    padding: 2px 0 2px 22px;

    border-left: 2px solid var(--color-accent);

    color: var(--color-text-muted);
  }

  .article-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  /* ------------------------------
     Code
  ------------------------------ */

  .article-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }

  .article-body :global(:not(pre) > code) {
    padding: 0.16em 0.38em;

    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .article-body :global(pre) {
    max-width: 100%;
    margin: 2.2em 0;
    padding: 20px 22px;

    overflow-x: auto;

    border: 1px solid var(--color-border);
    border-radius: 6px;

    line-height: 1.65;
  }

  /* ------------------------------
     Images
  ------------------------------ */

  .article-body :global(img) {
    display: block;

    max-width: 100%;
    height: auto;

    margin: 2.8em auto;
  }

  .article-body :global(figure) {
    margin: 2.8em 0;
  }

  .article-body :global(figure img) {
    margin: 0 auto;
  }

  .article-body :global(figcaption) {
    margin-top: 10px;

    color: var(--color-text-light);

    font-size: 0.78rem;
    line-height: 1.6;
    text-align: center;
  }

  /* ------------------------------
     Table
  ------------------------------ */

  .article-body :global(table) {
    display: block;

    width: 100%;
    max-width: 100%;
    margin: 2.2em 0;

    overflow-x: auto;

    border-collapse: collapse;

    font-size: 0.92rem;
  }

  .article-body :global(th),
  .article-body :global(td) {
    padding: 10px 14px;

    border-bottom: 1px solid var(--color-border);

    text-align: left;
    white-space: nowrap;
  }

  .article-body :global(th) {
    font-weight: 600;
  }

  /* ------------------------------
     Divider
  ------------------------------ */

  .article-body :global(hr) {
    margin: 4.5em 0;

    border: 0;
    border-top: 1px solid var(--color-border);
  }

  /* ------------------------------
     Article Footer
  ------------------------------ */

  .article-footer {
    margin-top: 96px;
    padding-top: 32px;

    border-top: 1px solid var(--color-border);
  }

  .article-footer-section + .article-footer-section {
    margin-top: 36px;
  }

  .footer-label {
    margin-bottom: 12px;

    color: var(--color-text-light);

    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .tag-list li {
    color: var(--color-text-muted);

    font-size: 0.88rem;
  }

  .project-link {
    font-size: 0.95rem;
    font-weight: 500;

    transition: color 160ms ease;
  }

  .project-link:hover {
    color: var(--color-accent);
  }

  /* ------------------------------
     Mobile
  ------------------------------ */

  @media (max-width: 700px) {
    .article-page {
      width: min(calc(100% - 32px), var(--page-width));
      padding: 64px 0 96px;
    }

    .article-header h1 {
      margin-top: 16px;

      font-size: 2.15rem;
      line-height: 1.28;
    }

    .article-description {
      margin-top: 18px;

      font-size: 1rem;
      line-height: 1.72;
    }

    .article-date {
      margin-top: 20px;
    }

    .article-divider {
      margin: 46px 0 52px;
    }

    .article-body {
      font-size: 1rem;
      line-height: 1.84;

      word-break: normal;
    }

    .article-body :global(p) {
      margin-bottom: 1.55em;
    }

    .article-body :global(h2) {
      margin-top: 3em;

      font-size: 1.5rem;
    }

    .article-body :global(h3) {
      margin-top: 2.4em;

      font-size: 1.2rem;
    }

    .article-body :global(pre) {
      margin-right: -4px;
      margin-left: -4px;
      padding: 18px;
    }

    .article-body :global(blockquote) {
      padding-left: 16px;
    }

    .article-footer {
      margin-top: 72px;
    }
  }
</style>